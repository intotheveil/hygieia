# --- Secrets / env (NEVER commit; .env.example carries NAMES only) ---
.env
.env.*
!.env.example
*.local

# --- Node / build ---
node_modules
dist
*.tsbuildinfo
*.log

# --- Playwright (e2e) output ---
playwright-report/
test-results/
blob-report/

# --- Editor / OS ---
.vscode/*
.idea
.DS_Store

# --- Claude build-kit local state (the kit itself IS committed) ---
.claude/settings.local.json
.claude/checkpoints.log
.claude/CLAUDE.md.bak
.claude/CLAUDE.md.pre-kit
.claude/worktrees/
