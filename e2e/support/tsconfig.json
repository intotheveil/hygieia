{
  // Typechecks the e2e suite and playwright.config.ts (TS strict, CLAUDE.md §3.6). `npm run e2e`
  // runs `tsc -p e2e/support/tsconfig.json` before Playwright, because the root `tsc -b` references
  // only app/node/scripts. Paths are relative to this file. The specs import the dictionary
  // (`src/i18n/dictionary.ts`) to assert rendered VALUES; it is pulled in through the import graph.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["../**/*.ts", "../**/*.mjs", "../../playwright.config.ts"]
}
